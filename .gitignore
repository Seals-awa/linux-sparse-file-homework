# ============================================================================
#  .gitignore  ——  GitHub C 模板 + 本项目的作业产物
#  说明: 本项目为“空洞文件 + 模拟下载定点写入”，运行会生成 .bin / .progress / .log
# ============================================================================

# -------------------------- 一、GitHub C 模板 -------------------------------
# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# -------------------------- 二、本项目的编译产物 ---------------------------
sparse_file

# -------------------------- 三、运行期生成的数据 ---------------------------
# 空洞文件 / 演示数据(每次运行内容都变, 256KB 二进制没必要入库)
*.bin
demo*.bin
*.bin.tmp

# 断点续传的进度文件(已完成偏移)
*.progress
*.progress.tmp

# 自写日志
*.log

# 自测脚本的临时工作目录
tmp_test/

# -------------------------- 四、密钥 / 凭据(绝不入库) ----------------------
.ssh/
.ssh-deploy/
*.pem
id_ed25519
id_ed25519.pub
id_rsa
id_rsa.pub

# -------------------------- 五、编辑器 / 系统垃圾 --------------------------
*.swp
*.swo
*~
.*.swp
.vscode/
.idea/
.cache/
compile_commands.json
.DS_Store
Thumbs.db
desktop.ini
